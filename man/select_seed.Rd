\name{select_seed}
\alias{select_seed}
\title{Initial value of a select input}
\usage{
select_seed(x)
}
\arguments{
\item{x}{a select_input component}
}
\value{
character value, or NULL
}
\description{
A single select displays its first choice when nothing is
selected, so that is its value. A multiple select displays
nothing selected, so it has none.
}
\keyword{internal}
