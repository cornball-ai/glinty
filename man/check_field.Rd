\name{check_field}
\alias{check_field}
\title{Validate and normalize one field value}
\usage{
check_field(value, spec, type, nm)
}
\arguments{
\item{value}{the supplied value}

\item{spec}{a field spec}

\item{type}{character component type, for the error message}

\item{nm}{character field name, for the error message}
}
\value{
the value, coerced to its declared type
}
\description{
Validate and normalize one field value
}
