\docType{data}
\name{TEXT_VARIANT_CLASSES}
\alias{TEXT_VARIANT_CLASSES}
\title{The class a text variant adds beyond its base}
\format{
An object of class \code{character} of length 9.
}
\usage{
TEXT_VARIANT_CLASSES
}
\description{
One map for every place a string carries a variant -- `text`,
`text_output`, a key_value item -- keyed by [TEXT_VARIANTS], and
the browser's `textVariantClass()` is its mirror. "" for normal.
}
\keyword{internal}
