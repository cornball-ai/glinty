{
  "protocol": 3,
  "transcripts": [
    {
      "name": "hello-welcome",
      "notes": "the opening exchange; the client declares what it can render, the server answers with the theme, the tree and its revision. The theme here is glinty's default token set; a themeless app omits the field and each frontend's own defaults apply",
      "frames": [
        {
          "dir": "in",
          "message": {
            "type": "hello",
            "protocol": 3,
            "client": "example/0.0.1",
            "components": ["page", "heading", "text_input", "text_output"],
            "kinds": ["text"],
            "features": ["measure"]
          }
        },
        {
          "dir": "out",
          "message": {
            "type": "welcome",
            "session": "s1",
            "protocol": 3,
            "theme": {
              "colors": {
                "primary": "#2456d6",
                "on_primary": "#ffffff",
                "surface": "#ffffff",
                "background": "#ffffff",
                "text": "#1a1a1a",
                "muted": "#6a6a6a",
                "border": "#d0d0d5",
                "danger": "#b3261e"
              },
              "spacing": 4,
              "radius": 6,
              "font": {
                "body": "system-ui",
                "mono": "ui-monospace",
                "size": 16
              }
            },
            "ui_revision": "f495e3f2685614c4c5f5768b987c2767178d4b85c051c6288174d113a00e40a9",
            "ui": {
              "component": "page",
              "children": [
                {
                  "component": "heading",
                  "value": "Demo",
                  "level": 1
                },
                {
                  "component": "text_input",
                  "id": "name",
                  "label": "Name:",
                  "value": "",
                  "emit": "live"
                },
                {
                  "component": "text_output",
                  "id": "greeting",
                  "variant": "normal"
                }
              ],
              "title": "Demo"
            }
          }
        }
      ]
    },
    {
      "name": "hello-welcome-hydrated",
      "notes": "the same exchange when the client already has matching pre-rendered markup: it adopts rather than rebuilds, and sends nothing",
